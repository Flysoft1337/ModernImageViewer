<Window x:Class="ModernImageViewer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:ModernImageViewer.UI.Controls"
        Title="{Binding Title}"
        Width="1180" Height="760" MinWidth="720" MinHeight="520"
        Background="{DynamicResource WindowBackgroundBrush}"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
        PreviewKeyDown="OnPreviewKeyDown"
        WindowStartupLocation="CenterScreen">
  <Window.InputBindings>
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
    <KeyBinding Key="Left" Command="{Binding PreviousCommand}" />
    <KeyBinding Key="Right" Command="{Binding NextCommand}" />
  </Window.InputBindings>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,7">
      <Grid>
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding OpenCommand}" ToolTip="Ctrl+O" automation:AutomationProperties.Name="{Binding OpenLabel}">
            <StackPanel Orientation="Horizontal"><Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource PrimaryTextBrush}" Data="{StaticResource Icon.Open}" /><TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding OpenLabel}" /></StackPanel>
          </Button>
          <Separator Margin="6,5" />
          <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding PreviousCommand}" ToolTip="←" automation:AutomationProperties.Name="{Binding PreviousLabel}"><Path Width="18" Height="18" Stretch="Uniform" Fill="{DynamicResource PrimaryTextBrush}" Data="{StaticResource Icon.Previous}" /></Button>
          <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding NextCommand}" ToolTip="→" automation:AutomationProperties.Name="{Binding NextLabel}"><Path Width="18" Height="18" Stretch="Uniform" Fill="{DynamicResource PrimaryTextBrush}" Data="{StaticResource Icon.Next}" /></Button>
          <Separator Margin="6,5" />
          <Button Style="{StaticResource ToolbarButtonStyle}" IsEnabled="{Binding HasImage}" Click="OnFitClick" ToolTip="0" Content="{Binding FitLabel}" />
          <Button Style="{StaticResource ToolbarButtonStyle}" IsEnabled="{Binding HasImage}" Click="OnActualSizeClick" ToolTip="1" Content="{Binding ActualSizeLabel}" />
          <Button Style="{StaticResource ToolbarButtonStyle}" IsEnabled="{Binding HasImage}" Click="OnZoomOutClick" ToolTip="-" automation:AutomationProperties.Name="{Binding ZoomOutLabel}"><Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource PrimaryTextBrush}" Data="{StaticResource Icon.ZoomOut}" /></Button>
          <Button Style="{StaticResource ToolbarButtonStyle}" IsEnabled="{Binding HasImage}" Click="OnZoomInClick" ToolTip="+" automation:AutomationProperties.Name="{Binding ZoomInLabel}"><Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource PrimaryTextBrush}" Data="{StaticResource Icon.ZoomIn}" /></Button>
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding LanguageLabel}" />
          <ComboBox Width="120" ItemsSource="{Binding SupportedLanguages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="DisplayName" />
        </StackPanel>
      </Grid>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,7">
      <Grid>
        <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding CurrentFileName}" />
        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
          <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding DimensionsText}" />
          <TextBlock Margin="18,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding PositionText}" />
        </StackPanel>
        <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ZoomText}" />
      </Grid>
    </Border>
    <Grid>
      <controls:ImageViewport x:Name="Viewport" Image="{Binding CurrentImage}" />
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
        <Path Width="54" Height="54" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Data="{StaticResource Icon.Open}" />
        <TextBlock Margin="0,18,0,0" HorizontalAlignment="Center" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding EmptyTitle}" />
        <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding EmptyHint}" />
      </StackPanel>
      <Border Background="{DynamicResource OverlayBrush}" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <ProgressBar Width="180" Height="4" IsIndeterminate="True" />
          <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" Foreground="White" Text="{Binding StatusText}" />
        </StackPanel>
      </Border>
      <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="20" Padding="14,8" CornerRadius="6" Background="{DynamicResource SurfaceBrush}" Visibility="{Binding StatusText, Converter={StaticResource StringToVisibilityConverter}}">
        <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding StatusText}" />
      </Border>
    </Grid>
  </DockPanel>
</Window>
