<Window x:Class="ModernImageViewer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ModernImageViewer.UI.Controls"
        Title="{Binding Title}"
        Width="1100"
        Height="720"
        MinWidth="640"
        MinHeight="480"
        Background="#111318"
        WindowStartupLocation="CenterScreen">
  <Window.InputBindings>
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
  </Window.InputBindings>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#20232A" Padding="10">
      <StackPanel Orientation="Horizontal">
        <Button MinWidth="80" Padding="12,6" Command="{Binding OpenCommand}" Content="{Binding OpenLabel}" />
        <Button Margin="8,0,0,0" MinWidth="80" Padding="12,6" Click="OnFitClick" Content="{Binding FitLabel}" />
        <Button Margin="8,0,0,0" MinWidth="80" Padding="12,6" Click="OnActualSizeClick" Content="{Binding ActualSizeLabel}" />
        <TextBlock Margin="24,0,8,0" VerticalAlignment="Center" Foreground="#D4D4D8" Text="{Binding LanguageLabel}" />
        <ComboBox Width="120" ItemsSource="{Binding SupportedLanguages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="DisplayName" />
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#20232A" Padding="10,6">
      <TextBlock Foreground="#D4D4D8" Text="{Binding StatusText}" />
    </Border>
    <Grid>
      <controls:ImageViewport x:Name="Viewport" Image="{Binding CurrentImage}" />
      <Border Background="#99000000" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="18" Text="{Binding StatusText}" />
      </Border>
    </Grid>
  </DockPanel>
</Window>
