<Window x:Class="ModernImageViewer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:ModernImageViewer.UI.Controls"
        Title="{Binding Title}" Width="1280" Height="820" MinWidth="720" MinHeight="480"
        WindowStyle="None" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Segoe UI Variable, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" PreviewKeyDown="OnPreviewKeyDown"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="FrameIndexStyle" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="InputBorder" CornerRadius="4" BorderThickness="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}">
          <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="54" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
  </shell:WindowChrome.WindowChrome>
  <Grid x:Name="WindowLayout">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Border x:Name="TitleBar" Height="54" Padding="18,0,6,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Visibility="{Binding IsFullScreen, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource AccentSurfaceBrush}"><Path Style="{StaticResource IconStyle}" Width="16" Height="16" Stroke="{DynamicResource AccentBrush}" Data="{StaticResource Icon.Image}" /></Border>
          <TextBlock Text="{Binding AppName}" Margin="10,0,20,0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13">
            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
        </StackPanel>
        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding CurrentFileName}" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="10,0,20,0" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding OpenCommand}" ToolTip="Ctrl+O">
            <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconStyle}" Data="{StaticResource Icon.Open}" /><TextBlock Text="{Binding OpenLabel}" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <Button x:Name="SettingsButton" Style="{StaticResource ToolbarButtonStyle}" Click="OnSettingsClick" ToolTip="{Binding SettingsLabel}" AutomationProperties.Name="{Binding SettingsLabel}">
            <Path Style="{StaticResource IconStyle}" Data="{StaticResource Icon.More}" />
            <Button.ContextMenu>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Opened="OnSettingsOpened">
                <MenuItem Header="{Binding OpenFolderLabel}" InputGestureText="Ctrl+Shift+O" Click="OnOpenFolderClick" />
                <MenuItem Header="{Binding PasteFilesLabel}" InputGestureText="Ctrl+V" Command="{Binding PasteFilesCommand}" />
                <MenuItem Header="{Binding FileAssociationLabel}" Click="OnFileAssociationsClick" />
                <MenuItem Header="{Binding FileActionsLabel}">
                  <MenuItem Header="{Binding EditLabel}" InputGestureText="Ctrl+E" Click="OnEditClick" IsEnabled="{Binding CanEditStatic}" />
                  <MenuItem Header="{Binding RevealLabel}" InputGestureText="Ctrl+Shift+E" Click="OnRevealClick" IsEnabled="{Binding CanReveal}" />
                  <MenuItem Header="{Binding CopyPathLabel}" Click="OnCopyPathClick" IsEnabled="{Binding CanCopyPath}" />
                  <Separator />
                  <MenuItem Header="{Binding CopyPreviewLabel}" InputGestureText="Ctrl+C" Command="{Binding CopyPreviewCommand}" ToolTip="{Binding CopyPreviewHint}" />
                  <MenuItem Header="{Binding CopyOriginalLabel}" Command="{Binding CopyOriginalCommand}" ToolTip="{Binding CopyOriginalHint}" ToolTipService.ShowOnDisabled="True" />
                </MenuItem>
                <MenuItem Header="{Binding SortLabel}" IsEnabled="{Binding CanSort}" ToolTip="{Binding SortHint}" ToolTipService.ShowOnDisabled="True">
                  <MenuItem Header="{Binding SortNameLabel}" Tag="Name" IsCheckable="True" IsChecked="{Binding IsSortByName, Mode=OneWay}" Click="OnSortModeClick" />
                  <MenuItem Header="{Binding SortModifiedLabel}" Tag="ModifiedTime" IsCheckable="True" IsChecked="{Binding IsSortByModifiedTime, Mode=OneWay}" Click="OnSortModeClick" />
                  <MenuItem Header="{Binding SortSizeLabel}" Tag="Size" IsCheckable="True" IsChecked="{Binding IsSortBySize, Mode=OneWay}" Click="OnSortModeClick" />
                  <Separator />
                  <MenuItem Header="{Binding SortAscendingLabel}" Tag="Ascending" IsCheckable="True" IsChecked="{Binding IsSortAscending, Mode=OneWay}" Click="OnSortDirectionClick" />
                  <MenuItem Header="{Binding SortDescendingLabel}" Tag="Descending" IsCheckable="True" IsChecked="{Binding SortDescending, Mode=OneWay}" Click="OnSortDirectionClick" />
                </MenuItem>
                <Separator />
                <MenuItem Header="{Binding ViewOrientationLabel}" IsEnabled="{Binding HasImage}">
                  <MenuItem Header="{Binding RotateLeftLabel}" InputGestureText="Ctrl+Shift+R" Tag="Left" Click="OnOrientationClick"><MenuItem.Icon><Path Style="{StaticResource IconStyle}" Data="{StaticResource Icon.Refresh}" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><ScaleTransform ScaleX="-1" /></Path.RenderTransform></Path></MenuItem.Icon></MenuItem>
                  <MenuItem Header="{Binding RotateRightLabel}" InputGestureText="Ctrl+R" Tag="Right" Click="OnOrientationClick"><MenuItem.Icon><Path Style="{StaticResource IconStyle}" Data="{StaticResource Icon.Refresh}" /></MenuItem.Icon></MenuItem>
                  <Separator />
                  <MenuItem Header="{Binding FlipHorizontalLabel}" Tag="Horizontal" IsCheckable="True" IsChecked="{Binding IsFlippedHorizontally, Mode=OneWay}" Click="OnOrientationClick" />
                  <MenuItem Header="{Binding FlipVerticalLabel}" Tag="Vertical" IsCheckable="True" IsChecked="{Binding IsFlippedVertically, Mode=OneWay}" Click="OnOrientationClick" />
                  <Separator />
                  <MenuItem Header="{Binding ResetOrientationLabel}" Tag="Reset" Click="OnOrientationClick" IsEnabled="{Binding HasViewOrientation}" />
                </MenuItem>
                <MenuItem Header="{Binding InformationLabel}" InputGestureText="Ctrl+I" IsCheckable="True" IsChecked="{Binding ShowInformation, Mode=OneWay}" Click="OnInformationClick" />
                <MenuItem Header="{Binding FilmstripLabel}" InputGestureText="Ctrl+T" IsCheckable="True" IsChecked="{Binding ShowFilmstrip, Mode=OneWay}" Click="OnFilmstripClick" />
                <MenuItem Header="{Binding SlideshowLabel}" InputGestureText="F6" IsCheckable="True" IsChecked="{Binding IsSlideshowPlaying, Mode=OneWay}" IsEnabled="{Binding CanPlaySlideshow}" Click="OnSlideshowClick" />
                <MenuItem Header="{Binding FullScreenLabel}" InputGestureText="F11" IsCheckable="True" IsChecked="{Binding IsFullScreen, Mode=OneWay}" Click="OnFullScreenClick" />
                <Separator />
                <MenuItem Header="{Binding AppearanceLabel}">
                  <MenuItem x:Name="DarkThemeItem" Header="{Binding DarkThemeLabel}" Tag="Dark" IsCheckable="True" Click="OnThemeClick" />
                  <MenuItem x:Name="LightThemeItem" Header="{Binding LightThemeLabel}" Tag="Light" IsCheckable="True" Click="OnThemeClick" />
                  <MenuItem x:Name="SystemThemeItem" Header="{Binding SystemThemeLabel}" Tag="System" IsCheckable="True" Click="OnThemeClick" />
                </MenuItem>
                <MenuItem Header="{Binding LanguageLabel}"><MenuItem Header="简体中文" Tag="zh-CN" Click="OnLanguageClick" /><MenuItem Header="English" Tag="en-US" Click="OnLanguageClick" /></MenuItem>
                <MenuItem Header="{Binding BrowsingPreferencesLabel}">
                  <MenuItem Header="{Binding InformationLabel}" IsCheckable="True" IsChecked="{Binding ShowInformation, Mode=OneWay}" Click="OnInformationClick" />
                  <MenuItem Header="{Binding FilmstripLabel}" IsCheckable="True" IsChecked="{Binding ShowFilmstrip, Mode=OneWay}" Click="OnFilmstripClick" />
                  <Separator />
                  <MenuItem Header="{Binding SlideshowSpeedLabel}">
                  <MenuItem x:Name="Slideshow2Item" Header="{Binding Slideshow2Label}" Tag="2" IsCheckable="True" Click="OnSlideshowSpeedClick" />
                  <MenuItem x:Name="Slideshow5Item" Header="{Binding Slideshow5Label}" Tag="5" IsCheckable="True" Click="OnSlideshowSpeedClick" />
                  <MenuItem x:Name="Slideshow10Item" Header="{Binding Slideshow10Label}" Tag="10" IsCheckable="True" Click="OnSlideshowSpeedClick" />
                  </MenuItem>
                </MenuItem>
                <Separator /><MenuItem Header="{Binding RefreshLabel}" InputGestureText="F5" Click="OnRefreshClick" IsEnabled="{Binding HasImage}" />
                <MenuItem Header="{Binding HelpLabel}" InputGestureText="F1" Click="OnShortcutHelpClick" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Border Style="{StaticResource ToolDividerStyle}" />
          <Button Style="{StaticResource WindowButtonStyle}" Click="OnMinimizeClick" ToolTip="{Binding MinimizeLabel}" AutomationProperties.Name="{Binding MinimizeLabel}"><Path Width="12" Height="1" Stroke="{DynamicResource PrimaryTextBrush}" Data="M0,0 L12,0" /></Button>
          <Button Style="{StaticResource WindowButtonStyle}" Click="OnMaximizeClick" ToolTip="{Binding MaximizeLabel}" AutomationProperties.Name="{Binding MaximizeLabel}"><Path Width="11" Height="11" Stroke="{DynamicResource PrimaryTextBrush}" Data="M0,0 L10,0 10,10 0,10 Z" /></Button>
          <Button Style="{StaticResource CloseWindowButtonStyle}" Click="OnCloseClick" ToolTip="{Binding CloseLabel}" AutomationProperties.Name="{Binding CloseLabel}"><Path Style="{StaticResource IconStyle}" Width="13" Height="13" Data="{StaticResource Icon.Close}" /></Button>
        </StackPanel>
      </Grid>
    </Border>
    <Grid x:Name="CanvasLayout" Grid.Row="1" Background="{DynamicResource CanvasBrush}">
      <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsFullScreen}" Value="True"><Setter Property="Grid.RowSpan" Value="3" /></DataTrigger></Style.Triggers></Style></Grid.Style>
        <controls:ImageViewport x:Name="Viewport" Presentation="{Binding Presentation}" CanvasBackground="{DynamicResource CanvasBrush}">
          <controls:ImageViewport.Style><Style TargetType="controls:ImageViewport"><Setter Property="Margin" Value="28,28,28,92" /><Style.Triggers><DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Margin" Value="12,12,12,76" /></DataTrigger><DataTrigger Binding="{Binding IsFullScreen}" Value="True"><Setter Property="Margin" Value="0" /></DataTrigger></Style.Triggers></Style></controls:ImageViewport.Style>
        </controls:ImageViewport>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
          <Grid Width="180" Height="136" Margin="0,0,0,30">
            <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Border Width="108" Height="98" CornerRadius="14" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" VerticalAlignment="Center"><Border.RenderTransform><RotateTransform Angle="-14" /></Border.RenderTransform></Border>
            <Border Width="108" Height="98" CornerRadius="14" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Right" VerticalAlignment="Center"><Border.RenderTransform><RotateTransform Angle="14" /></Border.RenderTransform></Border>
            <Border Width="110" Height="116" CornerRadius="16" Background="{DynamicResource AccentSurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Width="52" Height="58" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2" Data="{StaticResource Icon.Image}" /></Border>
          </Grid>
          <TextBlock Text="{Binding WelcomeTitle}" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding WelcomeHint}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,12,0,28" HorizontalAlignment="Center" />
          <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenCommand}" HorizontalAlignment="Center"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconStyle}" Stroke="{DynamicResource AccentTextBrush}" Data="{StaticResource Icon.Open}" /><TextBlock Text="{Binding OpenLabel}" Margin="10,0,16,0" VerticalAlignment="Center" /><TextBlock Text="Ctrl + O" Opacity="0.7" FontSize="12" VerticalAlignment="Center" /></StackPanel></Button>
          <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnOpenFolderClick" HorizontalAlignment="Center" Margin="0,12,0,0" Foreground="{DynamicResource AccentBrush}" Content="{Binding OpenFolderLabel}" ToolTip="Ctrl+Shift+O" />
          <TextBlock Text="{Binding SupportedFormatsOverview}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" Foreground="{DynamicResource SecondaryTextBrush}" Opacity="0.7" Margin="0,18,0,0" FontSize="11" HorizontalAlignment="Center" />
        </StackPanel>
        <Border x:Name="PreviewStatusOverlay" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Padding="12,8"
                CornerRadius="10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
          <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding ShowPreviewStatus}" Value="True" /><Condition Binding="{Binding IsChromeVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></Border.Style>
          <StackPanel Orientation="Horizontal">
            <ProgressBar Width="32" Height="3" IsIndeterminate="True" VerticalAlignment="Center" Margin="0,0,10,0"
                         Visibility="{Binding IsRefining, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Text="{Binding PreviewStatusText}" FontSize="12" VerticalAlignment="Center" MaxWidth="200"
                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" AutomationProperties.LiveSetting="Polite" />
            <Button Style="{StaticResource ToolbarButtonStyle}" Content="{Binding RefineLabel}" Margin="10,0,0,0"
                    Click="OnRefineClick" Visibility="{Binding IsRefining, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                    IsEnabled="{Binding CanRefine}" AutomationProperties.Name="{Binding RefineLabel}" />
            <Button Style="{StaticResource ToolbarButtonStyle}" Content="{Binding CancelLabel}" Margin="10,0,0,0"
                    Click="OnCancelRefinementClick" Visibility="{Binding IsRefining, Converter={StaticResource BooleanToVisibilityConverter}}"
                    AutomationProperties.Name="{Binding CancelLabel}" />
          </StackPanel>
        </Border>
        <Border x:Name="LoadingOverlay" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20" Padding="16,10" CornerRadius="10" Background="{DynamicResource SurfaceBrush}" ><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsLoading}" Value="True" /><Condition Binding="{Binding IsChromeVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></Border.Style><StackPanel Orientation="Horizontal"><ProgressBar Width="56" Height="3" IsIndeterminate="True" VerticalAlignment="Center" /><TextBlock Text="{Binding StatusText}" Margin="12,0,0,0" Foreground="{DynamicResource PrimaryTextBrush}" /></StackPanel></Border>
        <Border x:Name="MessageOverlay" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="14,9" CornerRadius="10" Background="{DynamicResource SurfaceBrush}" ><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="20" /><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ShowPreviewStatus}" Value="True"><Setter Property="Margin" Value="20,90,20,20" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasStatusMessage}" Value="True" /><Condition Binding="{Binding IsChromeVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" MaxWidth="300" Foreground="{DynamicResource PrimaryTextBrush}" AutomationProperties.LiveSetting="Polite" /></Border>
        <Border x:Name="Toolbar" HorizontalAlignment="Center" VerticalAlignment="Bottom" Padding="8,5" CornerRadius="14" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="12,0,12,20" /><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
            <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasImage}" Value="True" /><Condition Binding="{Binding IsChromeVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
            <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsFullScreen}" Value="True" /><Condition Binding="{Binding IsChromeVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
            <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsFullScreen}" Value="True" /><Condition Binding="{Binding IsFilmstripVisible}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Margin" Value="12,0,12,166" /></MultiDataTrigger>
          </Style.Triggers></Style></Border.Style>
          <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.18" /></Border.Effect>
          <StackPanel>
          <StackPanel x:Name="FrameControls" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4" Visibility="{Binding HasFrameSequence, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnAnimationToggleClick" ToolTip="{Binding AnimationPlayLabel}" AutomationProperties.Name="{Binding AnimationPlayLabel}" Visibility="{Binding IsAnimation, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Path><Path.Style><Style TargetType="Path" BasedOn="{StaticResource IconStyle}"><Setter Property="Data" Value="{StaticResource Icon.Play}" /><Style.Triggers><DataTrigger Binding="{Binding IsAnimationPlaying}" Value="True"><Setter Property="Data" Value="{StaticResource Icon.Pause}" /></DataTrigger></Style.Triggers></Style></Path.Style></Path>
            </Button>
            <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnAnimationRestartClick" ToolTip="{Binding AnimationRestartLabel}" AutomationProperties.Name="{Binding AnimationRestartLabel}" Visibility="{Binding IsAnimation, Converter={StaticResource BooleanToVisibilityConverter}}"><Path Style="{StaticResource IconStyle}" Data="{StaticResource Icon.Refresh}" /></Button>
            <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnPreviousFrameClick" ToolTip="{Binding FramePreviousLabel}" AutomationProperties.Name="{Binding FramePreviousLabel}" IsEnabled="{Binding CanMovePreviousFrame}"><Path Style="{StaticResource IconStyle}" Data="{StaticResource Icon.Previous}" /></Button>
            <TextBlock Text="{Binding FramePositionLabel}" FontSize="12" VerticalAlignment="Center" Margin="4,0,6,0" />
            <TextBox x:Name="FrameIndexInput" Style="{StaticResource FrameIndexStyle}" Text="{Binding FrameIndexText, Mode=OneWay}" Width="56" Height="28" Padding="4,2" VerticalContentAlignment="Center" TextAlignment="Center" MaxLength="5" GotKeyboardFocus="OnFrameIndexFocus" PreviewKeyDown="OnFrameIndexKeyDown" LostKeyboardFocus="OnFrameIndexLostFocus" ToolTip="{Binding FrameIndexHint}" AutomationProperties.Name="{Binding FramePositionLabel}" />
            <TextBlock Text="{Binding FrameCountText}" Width="64" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
            <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnNextFrameClick" ToolTip="{Binding FrameNextLabel}" AutomationProperties.Name="{Binding FrameNextLabel}" IsEnabled="{Binding CanMoveNextFrame}"><Path Style="{StaticResource IconStyle}" Data="{StaticResource Icon.Next}" /></Button>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding PreviousCommand}" ToolTip="{Binding PreviousLabel}" AutomationProperties.Name="{Binding PreviousLabel}"><Path Style="{StaticResource IconStyle}" Data="{StaticResource Icon.Previous}" /></Button>
            <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding NextCommand}" ToolTip="{Binding NextLabel}" AutomationProperties.Name="{Binding NextLabel}"><Path Style="{StaticResource IconStyle}" Data="{StaticResource Icon.Next}" /></Button>
            <Border Style="{StaticResource ToolDividerStyle}" />
            <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnFitClick" ToolTip="{Binding FitLabel}" AutomationProperties.Name="{Binding FitLabel}"><Path Style="{StaticResource IconStyle}" Data="{StaticResource Icon.Fit}" /></Button>
            <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnActualSizeClick" ToolTip="{Binding ActualSizeLabel}" Content="1:1" FontSize="12" />
            <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnZoomOutClick" ToolTip="{Binding ZoomOutLabel}" AutomationProperties.Name="{Binding ZoomOutLabel}"><Path Style="{StaticResource IconStyle}" Data="{StaticResource Icon.ZoomOut}" /></Button>
            <TextBlock Text="{Binding ZoomText}" Width="54" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" />
            <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnZoomInClick" ToolTip="{Binding ZoomInLabel}" AutomationProperties.Name="{Binding ZoomInLabel}"><Path Style="{StaticResource IconStyle}" Data="{StaticResource Icon.ZoomIn}" /></Button>
            <Border Style="{StaticResource ToolDividerStyle}" />
            <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnSettingsClick" ToolTip="{Binding SettingsLabel}" AutomationProperties.Name="{Binding SettingsLabel}"><Path Style="{StaticResource IconStyle}" Data="{StaticResource Icon.More}" /></Button>
          </StackPanel>
          </StackPanel>
        </Border>
      <Border x:Name="InformationPanel" Panel.ZIndex="30" HorizontalAlignment="Right" Width="272" CornerRadius="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="12,12,12,92" /><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding ShowInformation}" Value="True" /><Condition Binding="{Binding IsChromeVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger><DataTrigger Binding="{Binding HasFrameSequence}" Value="True"><Setter Property="Margin" Value="12,12,12,136" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsFullScreen}" Value="True" /><Condition Binding="{Binding IsFilmstripVisible}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Margin" Value="12,12,12,238" /></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsFullScreen}" Value="True" /><Condition Binding="{Binding IsFilmstripVisible}" Value="True" /><Condition Binding="{Binding HasFrameSequence}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Margin" Value="12,12,12,282" /></MultiDataTrigger></Style.Triggers></Style></Border.Style>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource PanelScrollBarStyle}" /></ScrollViewer.Resources>
          <StackPanel Margin="22,18">
            <Grid><TextBlock Text="{Binding InformationLabel}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" /><Button HorizontalAlignment="Right" Style="{StaticResource ToolbarButtonStyle}" Click="OnInformationClick" ToolTip="{Binding CloseLabel}" AutomationProperties.Name="{Binding CloseLabel}"><Path Style="{StaticResource IconStyle}" Width="14" Height="14" Data="{StaticResource Icon.Close}" /></Button></Grid>
            <TextBlock Style="{StaticResource PanelLabelStyle}" Text="{Binding FileNameLabel}" /><TextBlock Style="{StaticResource PanelValueStyle}" Text="{Binding CurrentFileName}" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource PanelLabelStyle}" Text="{Binding InformationLocationLabel}" /><TextBox Text="{Binding InformationLocation, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock Style="{StaticResource PanelLabelStyle}" Text="{Binding DimensionsLabel}" /><TextBlock Style="{StaticResource PanelValueStyle}" Text="{Binding DimensionsText}" />
            <TextBlock Style="{StaticResource PanelLabelStyle}" Text="{Binding FormatLabel}" /><TextBlock Style="{StaticResource PanelValueStyle}" Text="{Binding FormatText}" />
            <TextBlock Style="{StaticResource PanelLabelStyle}" Text="{Binding FileSizeLabel}" /><TextBlock Style="{StaticResource PanelValueStyle}" Text="{Binding FileSizeText}" />
            <TextBlock Style="{StaticResource PanelLabelStyle}" Text="{Binding ModifiedLabel}" /><TextBlock Style="{StaticResource PanelValueStyle}" Text="{Binding ModifiedText}" />
            <StackPanel Visibility="{Binding HasFrameSequence, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Style="{StaticResource PanelLabelStyle}" Text="{Binding FramePositionLabel}" /><TextBlock Style="{StaticResource PanelValueStyle}" Text="{Binding FrameStatusText}" />
              <StackPanel Visibility="{Binding IsAnimation, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Style="{StaticResource PanelLabelStyle}" Text="{Binding FrameDurationLabel}" /><TextBlock Style="{StaticResource PanelValueStyle}" Text="{Binding FrameDurationText}" />
                <TextBlock Style="{StaticResource PanelLabelStyle}" Text="{Binding FrameLoopLabel}" /><TextBlock Style="{StaticResource PanelValueStyle}" Text="{Binding FrameLoopText}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,26,0,0" Visibility="{Binding HasMetadata, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,20,0,0"><TextBlock Text="{Binding ExifLabel}" FontSize="14" FontWeight="SemiBold" /></Border>
              <ItemsControl ItemsSource="{Binding MetadataItems}" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" /><TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="12" /></Grid></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <Button Margin="0,28,0,0" HorizontalAlignment="Left" Style="{StaticResource ToolbarButtonStyle}" Click="OnCopyPathClick" IsEnabled="{Binding HasImage}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconStyle}" Data="{StaticResource Icon.Copy}" /><TextBlock Text="{Binding CopyPathLabel}" Margin="8,0,0,0" /></StackPanel></Button>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <Border x:Name="Filmstrip" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,12,22,10">
      <Border.Style><Style TargetType="Border"><Setter Property="Grid.Row" Value="2" /><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsFilmstripVisible}" Value="True" /><Condition Binding="{Binding IsChromeVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
        <DataTrigger Binding="{Binding IsFullScreen}" Value="True"><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.RowSpan" Value="3" /><Setter Property="VerticalAlignment" Value="Bottom" /><Setter Property="Margin" Value="0,0,0,32" /></DataTrigger>
      </Style.Triggers></Style></Border.Style>
      <StackPanel>
        <Grid Margin="4,0,4,8"><TextBlock Text="{Binding DirectoryName}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,150,0" /><TextBlock Text="{Binding FolderImagesText}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" HorizontalAlignment="Right" /></Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding BrowseItems}" HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource ThumbnailButtonStyle}" Click="OnThumbnailClick" Loaded="OnThumbnailLoaded" ToolTip="{Binding FileName}" AutomationProperties.Name="{Binding FileName}"><StackPanel><Grid Width="84" Height="56" Background="{DynamicResource CanvasBrush}"><Path Stroke="{DynamicResource SecondaryTextBrush}" Data="{StaticResource Icon.Image}" Opacity="0.4"><Path.Style><Style TargetType="Path" BasedOn="{StaticResource IconStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=Thumbnail}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Path.Style></Path><controls:ThumbnailImage x:Name="Thumbnail" FilePath="{Binding FilePath}" Decoder="{Binding ThumbnailDecoder, RelativeSource={RelativeSource AncestorType=Window}}" Stretch="Uniform" /></Grid><TextBlock Text="{Binding FileName}" Margin="2,6,2,0" FontSize="10" TextTrimming="CharacterEllipsis" TextAlignment="Center" /></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Border>
    <Border x:Name="StatusBar" MinHeight="32" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,0">
      <Border.Style><Style TargetType="Border"><Setter Property="Grid.Row" Value="3" /><Setter Property="Visibility" Value="{Binding IsChromeVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" /><Style.Triggers><DataTrigger Binding="{Binding IsFullScreen}" Value="True"><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.RowSpan" Value="3" /><Setter Property="VerticalAlignment" Value="Bottom" /></DataTrigger></Style.Triggers></Style></Border.Style>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True" Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding DimensionsText}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBlock Text="{Binding FormatText}" Margin="16,0" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBlock Text="{Binding FileSizeText}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding PositionText}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
        <TextBlock Grid.Column="2" Text="{Binding KeyboardHint}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid>
    </Border>
  </Grid>
</Window>
