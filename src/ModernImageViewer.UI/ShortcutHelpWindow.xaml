<Window x:Class="ModernImageViewer.UI.ShortcutHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding Title}" Width="660" Height="740" MinWidth="400" MinHeight="400"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="OnPreviewKeyDown">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="54" ResizeBorderThickness="6" GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="54" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Padding="22,0,10,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                   Margin="0,0,48,0" TextTrimming="CharacterEllipsis" />
        <Button HorizontalAlignment="Right" Style="{StaticResource CloseWindowButtonStyle}" Click="OnCloseClick"
                ToolTip="{Binding CloseLabel}" AutomationProperties.Name="{Binding CloseLabel}"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Path Style="{StaticResource IconStyle}" Width="13" Height="13" Data="{StaticResource Icon.Close}" />
        </Button>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False" Focusable="True" AutomationProperties.Name="{Binding Title}">
      <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource PanelScrollBarStyle}" /></ScrollViewer.Resources>
      <StackPanel Margin="24,22,24,10">
        <Grid Margin="0,0,0,20">
          <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource AccentSurfaceBrush}" VerticalAlignment="Top">
            <Path Width="24" Height="18" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4"
                  Data="M2,2 L22,2 22,16 2,16 Z M6,6 L6.5,6 M10,6 L10.5,6 M14,6 L14.5,6 M18,6 L18.5,6 M6,9 L6.5,9 M10,9 L10.5,9 M14,9 L14.5,9 M18,9 L18.5,9 M7,12 L17,12" />
          </Border>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="{Binding Heading}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Intro}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap" LineHeight="19" Margin="0,6,0,0" />
          </StackPanel>
        </Grid>
        <ItemsControl ItemsSource="{Binding Groups}" IsTabStop="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border CornerRadius="12" Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8" />
                  <ItemsControl ItemsSource="{Binding Rows}" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,5">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Description}" FontSize="13" TextWrapping="Wrap"
                                     VerticalAlignment="Center" Margin="0,0,12,0" LineHeight="19" />
                          <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="176"
                                  Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                  BorderThickness="1" CornerRadius="5" Padding="8,4">
                            <TextBlock Text="{Binding Keys}" FontFamily="Consolas, Cascadia Mono" FontSize="11"
                                       TextWrapping="Wrap" TextAlignment="Right" LineHeight="17"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                          </Border>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="24,14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding FooterHint}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                   TextWrapping="Wrap" LineHeight="18" VerticalAlignment="Center" Margin="0,0,16,0" />
        <Button Grid.Column="1" Style="{StaticResource ToolbarButtonStyle}" Content="{Binding CloseLabel}" IsDefault="True"
                BorderBrush="{DynamicResource BorderBrush}" MinWidth="78" Click="OnCloseClick" />
      </Grid>
    </Border>
  </Grid>
</Window>
