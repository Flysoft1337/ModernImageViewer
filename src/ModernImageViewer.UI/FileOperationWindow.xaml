<Window x:Class="ModernImageViewer.UI.FileOperationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="440" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="0" GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
    <StackPanel>
      <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Margin="24,14,24,12"
                 FontSize="18" FontWeight="SemiBold" />
      <StackPanel Margin="24,6,24,22">
        <TextBlock x:Name="Description" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
        <TextBlock x:Name="FileName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,10,0,0" />
        <Grid x:Name="RenameFields" Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBox x:Name="NameInput" MinWidth="100" FontSize="14"
                   Foreground="{DynamicResource PrimaryTextBrush}" CaretBrush="{DynamicResource PrimaryTextBrush}"
                   SelectionBrush="{DynamicResource TextSelectionBrush}"
                   SelectionTextBrush="{DynamicResource SelectionForegroundBrush}"
                   SelectionOpacity="{DynamicResource TextSelectionOpacity}"
                   Background="{DynamicResource WindowBackgroundBrush}" Padding="10,8">
            <TextBox.Template>
              <ControlTemplate TargetType="TextBox">
                <Border x:Name="InputBorder" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"
                        BorderBrush="{DynamicResource BorderBrush}" Background="{TemplateBinding Background}">
                  <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </TextBox.Template>
          </TextBox>
          <TextBlock x:Name="Extension" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource SecondaryTextBrush}" />
        </Grid>
        <TextBlock x:Name="Feedback" TextWrapping="Wrap" Margin="0,12,0,0"
                   Foreground="{DynamicResource SecondaryTextBrush}" Visibility="Collapsed"
                   AutomationProperties.LiveSetting="Polite" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
          <Button x:Name="CancelButton" Style="{StaticResource ToolbarButtonStyle}" IsCancel="True" Padding="16,8"
                  BorderBrush="{DynamicResource BorderBrush}" />
          <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButtonStyle}" Click="OnConfirm" Margin="8,2,0,2" />
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
