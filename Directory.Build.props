<Project>
  <PropertyGroup>
    <Version>0.6.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <!-- The application uses WPF/Win32, with no WinRT projection APIs. -->
    <IncludeWindowsSDKRefFrameworkReferences>false</IncludeWindowsSDKRefFrameworkReferences>
    <SatelliteResourceLanguages>en;zh-CN;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <!-- SKElement uses a CPU surface; these pinned packages serve only the unused SKGLElement. -->
    <PrunePackageReference Include="OpenTK" Version="4.3.0" />
    <PrunePackageReference Include="OpenTK.GLWpfControl" Version="4.2.3" />
  </ItemGroup>
</Project>
